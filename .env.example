# --- Supabase (público, seguro de exponer al browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (SOLO server-side, nunca prefijo NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Workera (SOLO server-side, nunca prefijo NEXT_PUBLIC_) ---
# Se completa en Fase 4/5 cuando tengamos la documentación real de Workera.
WORKERA_API_BASE_URL=
WORKERA_API_KEY=

# --- Control del adaptador Workera ---
# "mock" mientras no esté conectada la API real, "live" cuando sí.
WORKERA_CLIENT_MODE=mock
