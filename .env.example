# --- Supabase (público, seguro de exponer al browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (SOLO server-side, nunca prefijo NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Workera (SOLO server-side, nunca prefijo NEXT_PUBLIC_) ---
# Nombres genéricos: el mecanismo de autenticación real de Workera todavía
# no está confirmado (ver docs/WORKERA_API_REQUIREMENTS.md). Se ajustarán en
# Fase 5 sin que el resto de la aplicación deba cambiar.

# "mock" (datos ficticios, MockWorkeraClient) o "http" (API real, Fase 5).
# En producción DEBE ser "http" explícitamente — el adaptador falla cerrado
# (WorkeraConfigurationError) en vez de usar el mock en silencio.
WORKERA_PROVIDER=mock

# Requeridos solo cuando WORKERA_PROVIDER=http.
WORKERA_BASE_URL=
WORKERA_CREDENTIAL=

# Opcional, milisegundos. Default 10000 si se omite.
WORKERA_REQUEST_TIMEOUT_MS=10000
