# --- Supabase local para la aplicación (público, seguro de exponer al browser) ---
# La URL corresponde al puerto compartido y versionado de supabase/config.toml.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (SOLO server-side, nunca prefijo NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth local (ver docs/AUTH_GOOGLE_OAUTH.md) ---
# Supabase CLI lee estas dos variables desde el archivo raíz `.env`.
# Next.js puede seguir usando `.env.local` para sus variables de aplicación.
# En producción se configuran directamente en Supabase Dashboard, no acá.
# Nunca en NEXT_PUBLIC_ -- el navegador nunca necesita ver estos valores.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Google Forms automático (SOLO server-side) ---
# Web App de Apps Script desplegada desde google-apps-script/.
GOOGLE_FORMS_WEB_APP_URL=
  # Secreto aleatorio de al menos 32 caracteres, compartido con WORKERA_SHARED_SECRET del script.
GOOGLE_FORMS_SHARED_SECRET=

# --- Workera (SOLO server-side, nunca prefijo NEXT_PUBLIC_) ---
# Mecanismo de autenticación CONFIRMADO por el manual oficial de Workera
# (Fase 5C): API_USER (correo de la cuenta) y API_KEY (32 caracteres
# alfanuméricos) se envían como headers HTTP en cada request REST.

# "mock" (datos ficticios, MockWorkeraClient) o "http" (API real).
# En producción DEBE ser "http" explícitamente — el adaptador falla cerrado
# (WorkeraConfigurationError) en vez de usar el mock en silencio.
WORKERA_PROVIDER=mock

# Requeridos solo cuando WORKERA_PROVIDER=http.
# Base URL confirmada: https://workera.com/apiClient/v1
WORKERA_BASE_URL=
WORKERA_API_USER=
WORKERA_API_KEY=

# Opcional, milisegundos. Default 10000 si se omite.
WORKERA_REQUEST_TIMEOUT_MS=10000

# --- Automatización del sync (Fase 6B, SOLO server-side, nunca NEXT_PUBLIC_) ---

# Interruptor de seguridad explícito: el endpoint del cron
# (GET /api/sync/workera) no realiza ningún sync real de negocio a menos
# que esta variable sea EXACTAMENTE "true". Deliberadamente sin valor por
# defecto -- ausente/cualquier otro valor = automatización inactiva, incluso
# si vercel.json llegara a desplegarse. NO se activa en esta fase (Fase 6B
# entrega la infraestructura código-completa; producción permanece
# deshabilitada hasta aprobación explícita).
WORKERA_SYNC_ENABLED=false

# Secreto INDEPENDIENTE de WORKERA_API_KEY y de SUPABASE_SERVICE_ROLE_KEY --
# nunca reutilizar ninguno de esos dos acá. Vercel Cron lo agrega
# automáticamente como header "Authorization: Bearer $CRON_SECRET" en cada
# invocación programada cuando esta variable está configurada en el
# proyecto de Vercel. Sin este secreto configurado, el camino de cron del
# endpoint queda permanentemente cerrado (fail-closed). Generar un valor de
# alta entropía con `openssl rand -base64 48` (mínimo 32 bytes).
CRON_SECRET=

# Días adicionales ANTES de D-1 que el cron vuelve a consultar, para
# capturar marcaciones MODIFICADO/INACTIVO/corregidas después del sync
# original de esos días (Fase 6B, ventana de reconciliación). Opcional,
# entero >= 0. Default 2 si se omite -- SYNC_SCHEDULE_PENDING_BUSINESS_CONFIRMATION,
# ver docs/WORKERA_SYNC_PHASE6B.md.
WORKERA_SYNC_RECONCILIATION_DAYS=2

# --- Escaneo de seguridad de comprobantes externos (SOLO server-side) ---
# La infraestructura de cuarentena puede probarse localmente, pero NO existe
# aún un adapter antimalware real. Mantener false fuera de tests locales.
EXPENSE_FILE_SCAN_ENABLED=false
EXPENSE_FILE_SCAN_PROVIDER=disabled
# Doble opt-in del simulador. Solo funciona cuando NODE_ENV != production y
# detecta un marcador sintético; nunca equivale a un antivirus.
EXPENSE_FILE_SCAN_ALLOW_FIXTURE=false

# --- Limpieza de documentos laborales huerfanos (SOLO server-side) ---
# Borra unicamente rutas de reservas vencidas y no consumidas, mediante leases
# fenced. Mantener false hasta aplicar y verificar la migracion del sweeper.
SUPPORTING_DOCUMENT_CLEANUP_ENABLED=false

# --- OCR de Rendiciones EX-4 (SOLO server-side) ---
# Interruptor fail-closed: cualquier valor distinto de "true" deja el worker
# completamente inactivo, aunque exista una invocación del cron.
EXPENSE_OCR_ENABLED=false

# "disabled" mientras no existan credenciales reales. Para habilitar usar
# exactamente "azure-document-intelligence".
EXPENSE_OCR_PROVIDER=disabled
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Opcional, milisegundos por request a Azure. Default 15000.
EXPENSE_OCR_REQUEST_TIMEOUT_MS=15000

# --- MFA (TOTP) para cuentas privilegiadas ---
# Interruptor del BLOQUEO, no de la funcionalidad. Con "false" la pantalla
# /seguridad/mfa existe y se puede inscribir un segundo factor, pero nadie
# queda bloqueado por no tenerlo: es el paso 1 del despliegue en dos pasos.
# Solo se pone en "true" DESPUÉS de que las cuentas privilegiadas inscribieron
# y verificaron su factor. Revertir un incidente es volver a "false" y
# redesplegar; el MFA inscrito no se pierde. Ver docs/MFA_DESIGN.md sección 8.
MFA_ENFORCEMENT_ENABLED=false

# --- Recepción de comprobantes por correo (SOLO server-side) ---
# Interruptor fail-closed. Mantener en false hasta verificar dominio y webhook
# `email.received` en Resend. Nunca usar prefijo NEXT_PUBLIC_ en estas claves.
EXPENSE_EMAIL_CAPTURE_ENABLED=false
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Solo hostname, sin protocolo ni ruta. Ej.: comprobantes.empresa.cl
RESEND_RECEIVING_DOMAIN=

# --- Recepción de comprobantes por WhatsApp Cloud API (SOLO server-side) ---
# Interruptor fail-closed. Mantener en false hasta configurar la app de Meta,
# verificar el webhook y completar la prueba controlada del runbook.
EXPENSE_WHATSAPP_CAPTURE_ENABLED=false
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Número público con código de país, por ejemplo +56912345678.
WHATSAPP_BUSINESS_NUMBER=
# Versión explícita configurada en Meta, por ejemplo vXX.X. No se fija en código.
WHATSAPP_GRAPH_API_VERSION=
# Secreto aleatorio independiente para HMAC; nunca reutilizar APP_SECRET ni tokens.
WHATSAPP_LINK_SECRET=
# Hostnames HTTPS exactos, separados por coma, entregados por Meta para media.
WHATSAPP_MEDIA_HOSTS=

# --- Salida contable de Rendiciones (SOLO server-side) ---
# Marcha blanca fail-closed. `dry-run` valida snapshots e idempotencia, pero
# nunca crea un asiento real ni llama un ERP. No habilitar otro proveedor sin
# revisión de contrato, credenciales en Secret Manager y prueba controlada.
EXPENSE_ACCOUNTING_EXPORT_ENABLED=false
EXPENSE_ACCOUNTING_PROVIDER=disabled
# Tamaño de cada claim (1..25), lotes por invocación (1..10) y presupuesto
# máximo del catch-up. Los defaults caben dentro de maxDuration=60 s.
EXPENSE_ACCOUNTING_BATCH_SIZE=10
EXPENSE_ACCOUNTING_MAX_BATCHES=4
EXPENSE_ACCOUNTING_MAX_RUNTIME_MS=45000
# Timeout por salida; debe dejar al menos 1 s del presupuesto para cerrar el
# lease. El adapter real deberá respetar AbortSignal e idempotency key.
EXPENSE_ACCOUNTING_JOB_TIMEOUT_MS=10000
# Heartbeat CRON exclusivo. 26 h cubren cron diario + jitter de Vercel Hobby.
# Rango permitido: 3600..604800 segundos.
EXPENSE_ACCOUNTING_WATCHDOG_STALE_SECONDS=93600
# Cambiar a true solo en ambientes donde la integración DEBE estar activa;
# si el flag se pierde, cron/watchdog responden 503 en vez de quedar silenciosos.
EXPENSE_ACCOUNTING_MONITOR_EXPECT_ENABLED=false
