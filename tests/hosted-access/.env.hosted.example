# Copiar fuera del repositorio o como `.env.hosted` (ignorado por Git).
HOSTED_BASE_URL=https://arcotex-workera-staging.vercel.app
# Sólo habilitar después de confirmar que el SHA candidato está desplegado.
HOSTED_EXECUTION_APPROVED=blocked

# Cuentas sintéticas dedicadas. Nunca usar personas reales.
HOSTED_RRHH_EMAIL=
HOSTED_RRHH_PASSWORD=
HOSTED_RRHH_TOTP_SECRET=
HOSTED_PRODUCTION_EMAIL=
HOSTED_PRODUCTION_PASSWORD=
HOSTED_PRODUCTION_TOTP_SECRET=
HOSTED_INSTALLATION_EMAIL=
HOSTED_INSTALLATION_PASSWORD=
HOSTED_INSTALLATION_TOTP_SECRET=
HOSTED_NO_ACCESS_EMAIL=
HOSTED_NO_ACCESS_PASSWORD=
HOSTED_NO_ACCESS_TOTP_SECRET=

# UUID de fixtures sintéticos. Los DENIED_AREA deben ser del área opuesta al rol.
HOSTED_RRHH_ALLOWED_EMPLOYEE_ID=
HOSTED_PRODUCTION_ALLOWED_EMPLOYEE_ID=
HOSTED_INSTALLATION_ALLOWED_EMPLOYEE_ID=
HOSTED_PRODUCTION_DENIED_AREA_EMPLOYEE_ID=
HOSTED_INSTALLATION_DENIED_AREA_EMPLOYEE_ID=
HOSTED_OTHER_COMPANY_EMPLOYEE_ID=
HOSTED_OUTSIDE_ROSTER_EMPLOYEE_ID=

# Marcadores sintéticos únicos que jamás deben aparecer en respuestas denegadas.
HOSTED_FORBIDDEN_CANARY_AREA=CANARY-DENIED-AREA
HOSTED_FORBIDDEN_CANARY_COMPANY=CANARY-DENIED-COMPANY
HOSTED_FORBIDDEN_CANARY_ROSTER=CANARY-OUTSIDE-ROSTER

# Directorio local; no incluir capturas, trazas ni HTML.
HOSTED_RESULTS_DIR=test-results/hosted-access-sanitized
