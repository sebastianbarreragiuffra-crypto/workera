# --- Ambiente compartido: arcotex-workera-staging (Supabase Cloud) ---
# Copia este archivo a `.env.staging` (gitignored, igual que .env.local) y
# completa los valores reales. NUNCA pongas los valores reales en este
# archivo .example ni los subas a Git.
#
# De dónde salen los valores reales:
#   - Project URL / anon key / service role key: Supabase Dashboard →
#     arcotex-workera-staging → Project Settings → API
#     (o `supabase projects api-keys --project-ref <ref>` si tienes acceso
#     al access token del proyecto).
#   - Cómo usarlo: correr `npm run dev` cargando este archivo en vez de
#     .env.local (ver docs/STAGING_ENVIRONMENT.md para el comando exacto).
#     .env.local sigue siendo el default para desarrollo diario contra el
#     Docker local -- este archivo es solo para cuando necesites ver/probar
#     algo que el otro PC también debe ver.

# --- Supabase (público, seguro de exponer al browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (SOLO server-side, nunca prefijo NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth ---
# Mismo Client ID que .env.local -- agregar el redirect URI de staging
# (https://<project-ref>.supabase.co/auth/v1/callback) en Google Cloud
# Console y en Supabase Dashboard → Authentication → Providers → Google.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Google Forms automático (SOLO server-side) ---
# El endpoint de Apps Script NO está atado a un proyecto Supabase -- puede
# ser el mismo valor que .env.local. Evaluar un Apps Script separado solo
# si se quiere aislar los formularios de prueba de staging de los de local.
GOOGLE_FORMS_WEB_APP_URL=
GOOGLE_FORMS_SHARED_SECRET=

# --- Workera (SOLO server-side, nunca prefijo NEXT_PUBLIC_) ---
# Mantener en "mock" para staging salvo que el equipo decida explícitamente
# probar la ingestión real contra credenciales de Workera desde acá.
WORKERA_PROVIDER=mock
WORKERA_BASE_URL=
WORKERA_API_USER=
WORKERA_API_KEY=
WORKERA_REQUEST_TIMEOUT_MS=10000

# --- Automatización del sync ---
# Permanece deshabilitada en staging -- mismo criterio que local, no se
# activa hasta aprobación explícita del equipo.
WORKERA_SYNC_ENABLED=false
CRON_SECRET=
WORKERA_SYNC_RECONCILIATION_DAYS=2

# --- MFA (TOTP) para cuentas privilegiadas ---
# Interruptor del BLOQUEO, no de la funcionalidad. Se activa recién en el paso
# 5 del rollout, junto con la migración que endurece los RPC, y nunca antes de
# que las cuentas privilegiadas hayan inscrito y verificado su factor.
# Ver docs/PLATFORM_OWNER_RUNBOOK.md.
MFA_ENFORCEMENT_ENABLED=false

# --- Recepción de comprobantes por correo (SOLO server-side) ---
# Mantener en false hasta verificar dominio y webhook email.received en Resend.
EXPENSE_EMAIL_CAPTURE_ENABLED=false
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_RECEIVING_DOMAIN=
