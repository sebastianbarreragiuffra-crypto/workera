# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.staging.example

# vercel
.vercel

# supabase local
/supabase/.branches
/supabase/.temp

# datos reales de la empresa (plantillas/exports no deben subirse al repo)
/src/lib/excel/templates/*
!/src/lib/excel/templates/.gitkeep
# `*.xlsx` por sí solo NO cubre el formato BIFF antiguo: la planilla que
# entrega RRHH es un .xls con nombres reales y quedaba fuera del filtro.
*.xlsx
*.xls
*.xlsm
!**/fixtures/**/*.xlsx
!**/fixtures/**/*.xls
!**/fixtures/**/*.xlsm

# typescript
*.tsbuildinfo
next-env.d.ts

# local-only manual verification scripts (never committed)
/scratch-*.ts
/.codex/

# git worktrees creados dentro del repo (copias completas de la app)
/.worktrees/

# borradores de Supabase Studio ("Untitled query N.sql")
/supabase/snippets/

# entregables generados (se regeneran, no se versionan)
/GESTORA-*.pdf
